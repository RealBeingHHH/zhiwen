# 知纹 (Zhiwen) · 环境变量配置
# 复制此文件为 .env，填入你自己的 API Key
#   cp .env.example .env
#
# 支持任何 OpenAI 兼容的 API（Bearer Token 认证 + /chat/completions 端点）

# ════════════════════════════════════════════════════════
# LLM API（必选——用于分析、推理、生成）
# ════════════════════════════════════════════════════════
#
# 选一个供应商，取消注释，填上你的 Key：

# ── DeepSeek（国内首选·性价比高）──
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ── OpenAI ──
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ── 通义千问（阿里云 DashScope）──
# OPENAI_API_KEY=sk-your-dashscope-key-here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ── Groq（免费额度·速度快）──
# OPENAI_API_KEY=gsk_your-groq-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ── Together AI ──
# OPENAI_API_KEY=your-together-key-here
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ── 硅基流动（SiliconFlow·国内中转）──
# OPENAI_API_KEY=sk-your-siliconflow-key-here
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── 本地 Ollama ──
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# ── 本地 vLLM / llama.cpp / text-generation-webui ──
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_MODEL=your-model


# ════════════════════════════════════════════════════════
# Gemini API（可选——Google 模型）
# ════════════════════════════════════════════════════════

# GEMINI_API_KEY=your-gemini-key-here


# ════════════════════════════════════════════════════════
# 视觉 API（可选——用于图片分析）
# ════════════════════════════════════════════════════════

# VISION_API_KEY=sk-your-vision-key-here
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o


# ════════════════════════════════════════════════════════
# 服务端口（可选——有默认值）
# ════════════════════════════════════════════════════════

# LIAOLIAO_PORT=9200
# TIANSHU_PORT=9000
# TIANSHU2_PORT=9001
# DINGQING_PORT=9100
# VOYAGER_PORT=8765
